      "checkConstraints": {
        "task_title_nonempty": {
          "name": "task_title_nonempty",
          "value": "length(trim(\"tasks\".\"title\")) > 0"
        },
        "task_status_valid": {
          "name": "task_status_valid",
          "value": "\"tasks\".\"status\" in ('inbox', 'planned', 'completed')"
        },
        "task_priority_valid": {
          "name": "task_priority_valid",
          "value": "\"tasks\".\"priority\" in ('none', 'low', 'medium', 'high')"
        },
        "task_completion_consistent": {
          "name": "task_completion_consistent",
          "value": "(\"tasks\".\"status\" = 'completed' AND \"tasks\".\"completed_at\" IS NOT NULL) OR (\"tasks\".\"status\" != 'completed' AND \"tasks\".\"completed_at\" IS NULL)"
        },
        "task_schedule_status": {
          "name": "task_schedule_status",
          "value": "\"tasks\".\"status\" = 'completed' OR (\"tasks\".\"status\" = 'planned' AND \"tasks\".\"scheduled_date\" IS NOT NULL) OR (\"tasks\".\"status\" = 'inbox' AND \"tasks\".\"scheduled_date\" IS NULL)"
        },
        "task_time_needs_date": {
          "name": "task_time_needs_date",
          "value": "\"tasks\".\"scheduled_date\" IS NOT NULL OR (\"tasks\".\"start_time\" IS NULL AND \"tasks\".\"end_time\" IS NULL)"
        },
        "task_end_after_start": {
          "name": "task_end_after_start",
          "value": "\"tasks\".\"end_time\" IS NULL OR (\"tasks\".\"start_time\" IS NOT NULL AND \"tasks\".\"end_time\" > \"tasks\".\"start_time\")"
        },
        "task_estimate_positive": {
          "name": "task_estimate_positive",
          "value": "\"tasks\".\"estimated_minutes\" IS NULL OR \"tasks\".\"estimated_minutes\" > 0"
        }
      }
