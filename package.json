{
  "name": "phd-research-workbench",
  "productName": "PhD 科研工作台",
  "version": "0.7.7",
  "description": "A local-first desktop workspace for deliberate research planning.",
  "author": "PhD 科研工作台",
  "private": true,
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=10"
  },
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "node scripts/prepare-pdfjs.mjs && electron-vite dev",
    "dev:seed": "node scripts/prepare-pdfjs.mjs && electron-vite dev -- --seed-demo",
    "build": "node scripts/prepare-pdfjs.mjs && npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "npm run build && node scripts/electron-smoke.mjs && node scripts/minute-smoke.mjs",
    "test:research": "node scripts/research-smoke.mjs",
    "test:paper-studio": "node scripts/paper-studio-smoke.mjs",
    "test:daily": "node scripts/daily-publications-smoke.mjs",
    "test:arxiv-live": "node scripts/arxiv-live-smoke.mjs",
    "test:translation": "node scripts/library-live-smoke.mjs",
    "test:translation-settings": "node scripts/translation-settings-smoke.mjs",
    "test:translation-onboarding": "node scripts/translation-engine-onboarding-smoke.mjs",
    "db:generate": "drizzle-kit generate",
    "package:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win nsis",
    "postinstall": "node scripts/check-sqlite.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^0.577.0",
    "motion": "^13.2.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "drizzle-kit": "^0.31.9",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "playwright": "^1.58.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "local.phd.researchworkbench",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/translation-progress.py",
        "to": "translation-progress.py"
      },
      {
        "from": "resources/pdf2zh-config.toml.example",
        "to": "pdf2zh-config.toml.example"
      },
      {
        "from": "src/main/database/migrations",
        "to": "migrations"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": "nsis",
      "artifactName": "PhD-Research-Workbench-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
